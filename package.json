{
  "name": "justicesphere-complianceos",
  "version": "1.0.0",
  "license": "MIT",
  "description": "JusticeSphere AI — ComplianceOS / GovernanceIQ: Autonomous Legal-to-Formal-Logic Compiler (SMT/Z3 + OPA Rego + AST) & Continuous Code/Schema Compliance Prover",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 5173 --host",
    "build": "vite build && tsc -p tsconfig.server.json && node -e \"require('fs').cpSync('server/analyzer/grammars','dist-server/server/analyzer/grammars',{recursive:true})\"",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "verify:cli": "tsx server/cli-verify.ts",
    "backup": "tsx server/cli/backup.ts",
    "verify:realworld": "tsx server/cli-realworld-demo.ts",
    "start:tsx": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "sarif": "tsx server/cli-sarif.ts",
    "setup:sandbox": "tsx server/cli/setup-sandbox.ts",
    "build:sql-grammar": "tsx server/cli/build-sql-grammar.ts",
    "eval:rag": "tsx server/cli-eval-rag.ts",
    "eval:extract": "tsx server/cli-eval-extract.ts",
    "seed:demo": "tsx server/cli/seed-demo.ts",
    "setup:keycloak": "tsx server/cli/setup-keycloak.ts",
    "voiceover": "node --env-file=.env.local --import tsx server/cli/voiceover.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1150.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "asn1js": "3.0.10",
    "cors": "^2.8.5",
    "diff": "^8.0.4",
    "express": "^4.21.2",
    "gpt-tokenizer": "4.0.0",
    "jose": "6.2.12",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.3",
    "neo4j-driver": "6.2.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "8.19.0",
    "pkijs": "3.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tar": "^7.5.22",
    "typescript": "^5.7.3",
    "z3-solver": "^4.13.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "^4.0.6",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/cors": "^2.8.17",
    "@types/diff": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript-eslint": "8.71.2",
    "vite": "^6.1.0",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
