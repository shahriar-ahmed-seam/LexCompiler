# LexCompiler — JusticeSphere AI (ComplianceOS / GovernanceIQ)
PORT=3001
NODE_ENV=development
# Bind address. Defaults to loopback; any other host requires LEXCOMPILER_API_TOKEN.
HOST=127.0.0.1
# Bearer token required on every /api route except /api/health when set.
LEXCOMPILER_API_TOKEN=
# Comma-separated browser origins allowed to call the API (defaults to localhost:5173/3001).
LEXCOMPILER_ALLOWED_ORIGINS=
# Extra Host header names accepted when no token is set (DNS-rebinding guard).
LEXCOMPILER_ALLOWED_HOSTS=
# Set to 1 to enable GET /api/sandbox/verify-runtime (executes target-repo Python locally).
LEXCOMPILER_ENABLE_RUNTIME_SANDBOX=0
# Repository to scan (defaults to the bundled target-repo/ fixture).
LEXCOMPILER_TARGET_REPO=
# Where the ledger, vector store, persisted clauses and signing key are kept.
LEXCOMPILER_DATA_DIR=
# Ed25519 attestation key (PEM text or a file path); generated in the data dir when unset.
LEXCOMPILER_SIGNING_KEY_PEM=
LEXCOMPILER_SIGNING_KEY_PATH=
# OPA binary used to evaluate the generated Rego policies (defaults to `opa` on PATH).
LEXCOMPILER_OPA_BIN=
# Ollama endpoint.
OLLAMA_HOST=http://localhost:11434
# Address people use to reach LexCompiler (links from GitHub check runs, GitHub App callback URLs).
LEXCOMPILER_PUBLIC_URL=http://localhost:3001
# GitHub App. Register it at /github/register (credentials go to data/github-app.json), or set them here.
LEXCOMPILER_GITHUB_WEBHOOK_URL=
LEXCOMPILER_GITHUB_APP_ID=
LEXCOMPILER_GITHUB_APP_SLUG=
LEXCOMPILER_GITHUB_APP_PRIVATE_KEY_PATH=
LEXCOMPILER_GITHUB_WEBHOOK_SECRET=
LEXCOMPILER_GITHUB_CLIENT_ID=
LEXCOMPILER_GITHUB_CLIENT_SECRET=
# GitHub pull-request integration (POST /api/remediation/open-github-pr).
LEXCOMPILER_GITHUB_TOKEN=
LEXCOMPILER_GITHUB_REPO=
LEXCOMPILER_GITHUB_BASE=
LEXCOMPILER_GITHUB_PATH_PREFIX=
# Cloud AI mode uses LEXCOMPILER_LLM_* below; with only this key set it uses gpt-4o-mini. Keys never come from the browser.
OPENAI_API_KEY=
# Runtime sandbox backends: real PostgreSQL / Redis servers (defaults: in-process PGlite and fakeredis).
LEXCOMPILER_POSTGRES_URL=
LEXCOMPILER_REDIS_URL=
LEXCOMPILER_SANDBOX_PYTHON=
# Graph RAG stores (defaults: PGlite pgvector in the data dir, in-memory graph).
LEXCOMPILER_PGVECTOR_URL=
LEXCOMPILER_NEO4J_URL=
LEXCOMPILER_NEO4J_USER=neo4j
LEXCOMPILER_NEO4J_PASSWORD=
# BGE cross-encoder reranker (requires `npm install @huggingface/transformers`).
LEXCOMPILER_RERANKER_MODEL=
# Email and password sign-in without an identity provider: "password". Create accounts with
# npm run seed:demo -- --accounts (passwords go to data/demo-accounts.txt).
LEXCOMPILER_SIGN_IN=
# Ceiling on AI tokens per workspace per day, whatever the workspace sets.
LEXCOMPILER_AI_MAX_DAILY_TOKENS=
# OIDC sign-in and projects.
LEXCOMPILER_OIDC_ISSUER=
LEXCOMPILER_OIDC_CLIENT_ID=
LEXCOMPILER_OIDC_CLIENT_SECRET=
LEXCOMPILER_OIDC_REDIRECT_URI=
LEXCOMPILER_OIDC_ROLES_CLAIM=roles
LEXCOMPILER_OIDC_ADMIN_ROLE=lexcompiler-admin
LEXCOMPILER_DEFAULT_PROJECT_ROLE=viewer
LEXCOMPILER_PROJECT_REPOS_ROOT=
# Attestation signing: local | gcp-kms | aws-kms, plus an optional RFC 3161 TSA.
LEXCOMPILER_SIGNER=local
LEXCOMPILER_GCP_KMS_KEY_VERSION=
LEXCOMPILER_AWS_KMS_KEY_ID=
LEXCOMPILER_TSA_URL=
# LLM agents (global default; per agent: LEXCOMPILER_AGENT_<ID>_MODEL / _PROVIDER / _BASE_URL / _API_KEY).
LEXCOMPILER_LLM_PROVIDER=openai
LEXCOMPILER_LLM_MODEL=
LEXCOMPILER_LLM_BASE_URL=
LEXCOMPILER_LLM_API_KEY=
# The Python crew (agents/) reaches its models through the server's agent route, /api/agents/llm/v1
# (operator token only). Configure each agent here, for example the Z3 critic on DeepSeek:
#   LEXCOMPILER_AGENT_Z3_FORMAL_CRITIC_PROVIDER=openai
#   LEXCOMPILER_AGENT_Z3_FORMAL_CRITIC_MODEL=deepseek-chat
#   LEXCOMPILER_AGENT_Z3_FORMAL_CRITIC_BASE_URL=https://api.deepseek.com
#   LEXCOMPILER_AGENT_Z3_FORMAL_CRITIC_API_KEY=
# Cloud tokens all agents may use per UTC day (default 100000); local models are not counted.
LEXCOMPILER_AGENT_MAX_DAILY_TOKENS=
# Local model for agent-polyglot-ast-mapper (Hermes-style tool calls on Ollama; default llama3.2, 3B; qwen2.5-coder:7b needs about 6 GB of free GPU memory).
LEXCOMPILER_HERMES_MODEL=
# Local AI mode: the model on OLLAMA_HOST (default qwen2.5-coder:0.5b).
LEXCOMPILER_LOCAL_LLM_MODEL=
# AI on the demo screens, which use the bundled fixture: local (default), cloud, or off.
# Each workspace has its own setting, off until the owner changes it.
LEXCOMPILER_DEMO_AI_MODE=
# Ollama embedding model for RAG (default all-minilm:latest); "none" uses feature hashing.
LEXCOMPILER_EMBEDDING_MODEL=
# LLMLingua-2 sidecar interpreter (with `pip install llmlingua`).
LEXCOMPILER_LLMLINGUA_PYTHON=
# External MCP servers (mcp-servers.json format) and CLI clause file for real repositories.
LEXCOMPILER_EXTERNAL_MCP_CONFIG=
LEXCOMPILER_CLAUSES_FILE=
# Container isolation for the runtime sandbox (docker build -f Dockerfile.sandbox -t lexcompiler-sandbox:1 .).
LEXCOMPILER_SANDBOX_CONTAINER=
LEXCOMPILER_SANDBOX_IMAGE=lexcompiler-sandbox:1
LEXCOMPILER_SANDBOX_OCI_RUNTIME=
