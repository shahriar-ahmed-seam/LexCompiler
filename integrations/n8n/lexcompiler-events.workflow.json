        "language": "javaScript",
        "jsCode": "const d = $input.first().json.event.data;\nconst rules = (d.matchedRules || []).join(', ') || 'none';\nreturn [{ json: {\n  title: 'Regulation watch: ' + d.title,\n  text: (d.summary ? d.summary + '\\n' : '') + 'This notice may affect these rules: ' + rules + '. Legal decides whether a rule changes.',\n  url: d.link || '',\n} }];"
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Format regulation.watch",
      "type": "n8n-nodes-base.code",
