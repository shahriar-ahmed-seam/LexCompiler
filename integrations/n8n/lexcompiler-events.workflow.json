    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $input.first().json.event.data;\nconst where = d.path ? ' in ' + d.path + (d.line ? ':' + d.line : '') : '';\nconst until = d.status === 'approved' && d.expiresAt ? ' until ' + String(d.expiresAt).slice(0, 10) : '';\nreturn [{ json: {\n  title: 'Exception ' + d.status + ' for ' + d.rule,\n  text: 'The exception to ' + d.rule + (d.repository ? ' on ' + d.repository : '') + where + ' was ' + d.status + until + '.' + (d.decisionNote ? ' Note: ' + d.decisionNote : ''),\n  url: d.url || '',\n} }];"
      },
