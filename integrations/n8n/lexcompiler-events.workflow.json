    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const d = $input.first().json.event.data;\nconst where = d.path ? ' in ' + d.path + (d.line ? ':' + d.line : '') : '';\nreturn [{ json: {\n  title: 'Exception requested for ' + d.rule,\n  text: (d.requester || 'Someone') + ' asked for an exception to ' + d.rule + (d.repository ? ' on ' + d.repository : '') + where + '. It is waiting for Legal.',\n  url: d.url || '',\n} }];"
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Format exception.requested",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        260
