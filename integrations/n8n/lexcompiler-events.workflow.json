    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const e = $input.first().json.event;\nconst d = e.data;\nconst where = d.repository + (d.prNumber ? ' pull request #' + d.prNumber : '') + ' at commit ' + String(d.commit).slice(0, 7);\nconst lines = (d.findings || [])\n  .filter((f) => f.state === 'new')\n  .slice(0, 5)\n  .map((f) => '- ' + f.rule + ': ' + f.path + ':' + f.line + ' ' + (f.message || ''));\nconst more = d.counts.new > lines.length ? '\\n...and ' + (d.counts.new - lines.length) + ' more new findings.' : '';\nreturn [{ json: {\n  title: 'LexCompiler check ' + (d.conclusion || 'finished') + ' on ' + d.repository,\n  text: where + ' was checked: ' + d.counts.new + ' new, ' + d.counts.existing + ' existing and ' + d.counts.waived + ' waived findings.' + (lines.length ? '\\n' + lines.join('\\n') + more : ''),\n  url: d.url || '',\n} }];"
      },
