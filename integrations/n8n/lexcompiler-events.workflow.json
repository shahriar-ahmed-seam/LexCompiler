      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Checks X-LexCompiler-Signature: sha256=<hex HMAC-SHA256(secret, raw body)> over the exact bytes LexCompiler sent.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = $env.LEXCOMPILER_WEBHOOK_SECRET;\nif (!secret) throw new Error('Set LEXCOMPILER_WEBHOOK_SECRET on the n8n container (see integrations/n8n/README.md).');\n\nconst headers = item.json.headers || {};\nconst given = String(headers['x-lexcompiler-signature'] || '');\n\n// The Webhook node (option \"Raw Body\") keeps the unparsed body as binary data, in the property \"data\".\nlet raw = null;\nif (item.binary && item.binary.data) {\n  try {\n    raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n  } catch (err) {\n    raw = Buffer.from(item.binary.data.data || '', 'base64');\n  }\n}\nif (!raw) return [{ json: { valid: false, reason: 'the raw body is not available: turn on Raw Body on the Webhook node', event: null } }];\n\nconst expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst a = Buffer.from(given);\nconst b = Buffer.from(expected);\nconst valid = a.length === b.length && crypto.timingSafeEqual(a, b);\nlet event = null;\nif (valid) {\n  try {\n    event = JSON.parse(raw.toString('utf8'));\n  } catch (err) {\n    return [{ json: { valid: false, reason: 'the body is not JSON', event: null } }];\n  }\n}\nreturn [{ json: { valid, event } }];"
      },
