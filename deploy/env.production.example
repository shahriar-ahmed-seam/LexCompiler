# Copy to deploy/.env.production (never commit it) and fill in. See docs/DEPLOY.md.

# The public host name; Caddy gets its certificate.
LEXCOMPILER_DOMAIN=lexc.example.com
LEXCOMPILER_PUBLIC_URL=https://lexc.example.com
LEXCOMPILER_ALLOWED_ORIGINS=https://lexc.example.com
LEXCOMPILER_ALLOWED_HOSTS=lexc.example.com

# A public server needs sign-in (OIDC), an API token, or both.
# openssl rand -base64 32
LEXCOMPILER_API_TOKEN=
LEXCOMPILER_OIDC_ISSUER=
LEXCOMPILER_OIDC_CLIENT_ID=
LEXCOMPILER_OIDC_CLIENT_SECRET=
LEXCOMPILER_OIDC_REDIRECT_URI=https://lexc.example.com/api/auth/callback

# GitHub App: register it at https://lexc.example.com/github/register (stored in the data volume),
# or set the App's values here. The webhook URL defaults to <public URL>/api/github/webhooks.
LEXCOMPILER_GITHUB_WEBHOOK_URL=

# Requests per minute per client: webhooks, share pages and keys, sign-in.
LEXCOMPILER_RATE_LIMITS=webhooks=600,share=120,signin=30

# Cloud models, if a workspace turns them on.
LEXCOMPILER_LLM_PROVIDER=
LEXCOMPILER_LLM_MODEL=
LEXCOMPILER_LLM_API_KEY=
